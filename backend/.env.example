# Copy this file to .env and fill in your own values. Never commit .env.
# The backend reads .env once at startup, so restart it after any change.

# Gemini API key (required). Create one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here

# Optional: several keys, separated by spaces. Each request picks one at random,
# which spreads the load across keys and helps avoid rate limits.
# When set, it takes priority and GOOGLE_API_KEY is ignored.
# GOOGLE_API_KEYS=key_one key_two key_three

# Optional: extra allowed origins for CORS, separated by commas.
# http://localhost:5173 and http://127.0.0.1:5173 are already allowed.
# CORS_ORIGINS=https://your-frontend.example.com,https://another.example.com
